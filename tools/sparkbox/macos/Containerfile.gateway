# The nested macOS gateway image.
#
# This image deliberately contains NO sparkbox binary.
#
# It used to build one: a golang stage compiled ./cmd/sparkbox from the working
# tree and baked the result at /usr/local/bin/sparkbox. That had two costs. It
# made every macOS onboarding require the git repo, a Go toolchain and network
# access for `go mod download` — none of which someone who downloaded a released
# binary has. And, the bug we actually hit, it decoupled the machine's control
# plane from the release it provisions: a machine built at v0.3.0-5-g18bfe3b was
# provisioned with `--release v0.4.0`, so it fetched v0.4.0's kernel, firecracker
# and rootfs and drove them with a v0.3.0-era sparkbox. The evidence bundle
# recorded both numbers and nothing compared them.
#
# Since A1, `sparkbox setup` installs the binary it is running from (see
# stepInstallBinary). So the machine does not need a baked one: poc.sh runs
# /usr/local/sbin/sparkbox-bootstrap in the machine, which downloads the
# released sparkbox-linux-<arch> for the tag being provisioned and verifies it
# against SHA256_SPARKBOX in that same release's manifest, and then runs `setup`
# from the staged copy. The binary and the artifacts it fetches are the same
# release by construction, and there is no second copy that could differ.
#
# Consequence for the build context: this file needs only the two scripts beside
# it, never the Go module. poc.sh therefore builds it from a two-file staging
# directory (macos/out/image-context) rather than from tools/sparkbox.
ARG UBUNTU_IMAGE=docker.io/library/ubuntu:24.04@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90

FROM ${UBUNTU_IMAGE}

ENV container=container
ENV DEBIAN_FRONTEND=noninteractive

# curl + ca-certificates are load-bearing, not conveniences: sparkbox-bootstrap
# fetches the release manifest and binary over HTTPS with them, and
# gateway-verify.sh proves that path works before anything depends on it.
#
# python3 is here for the same reason and is just as load-bearing: the inner
# `setup` runs deploy/refresh-agent-tools.sh to bake claude/codex/pi/hivemind
# into the rootfs templates, and that script parses the release manifests with it
# and MERGES the guest's ~/.claude.json rather than clobbering a real user's
# accumulated state. Without it the machine provisions cleanly and every sandbox
# it creates is empty. debugfs (e2fsprogs, below) is the other half: it is how
# the refresher reads each template's own stamp instead of trusting a host-side
# one.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      dbus \
      e2fsprogs \
      iproute2 \
      iptables \
      python3 \
      systemd \
      systemd-sysv \
      util-linux \
      xfsprogs \
      zerofree \
      zstd \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Follow Apple's container-machine systemd image pattern. Machine identity is
# generated on first boot; units that assume hardware or a traditional login
# session are masked in this VM-shaped environment.
RUN truncate -s 0 /etc/machine-id \
    && mkdir -p /var/lib/dbus \
    && truncate -s 0 /var/lib/dbus/machine-id \
    && ln -sfn /lib/systemd/system/multi-user.target /etc/systemd/system/default.target \
    && for unit in \
      console-getty.service \
      dev-hugepages.mount \
      sys-fs-fuse-connections.mount \
      systemd-tmpfiles-setup.service \
      systemd-update-utmp.service; \
      do ln -sfn /dev/null "/etc/systemd/system/${unit}"; done

COPY gateway-verify.sh /usr/local/sbin/sparkbox-poc-verify
COPY sparkbox-bootstrap.sh /usr/local/sbin/sparkbox-bootstrap

RUN chmod 0755 /usr/local/sbin/sparkbox-poc-verify /usr/local/sbin/sparkbox-bootstrap \
    && mkdir -p /var/lib/sparkbox-bootstrap \
    && printf '%s\n' 'sparkbox-macos-nested-poc=1' > /etc/sparkbox-poc

LABEL io.sparkbox.macos-nested-poc="true"

CMD ["/sbin/init"]
