docker network create --label sparkbox.devpod=sparkbox-dev --subnet 172.29.128.0/24 sparkbox-dev-net
docker volume create --label sparkbox.devpod=sparkbox-dev sparkbox-dev-tmp
docker volume create --label sparkbox.devpod=sparkbox-dev sparkbox-dev-checkpoint-scratch
docker volume create --label sparkbox.devpod=sparkbox-dev sparkbox-dev-vmm-socket
docker volume create --label sparkbox.devpod=sparkbox-dev sparkbox-dev-sluice-socket
docker run --detach --name sparkbox-dev-netns --label sparkbox.devpod=sparkbox-dev --label sparkbox.devpod.container=netns --platform linux/arm64 --network sparkbox-dev-net --sysctl net.ipv4.ip_forward=1 --sysctl net.ipv6.conf.all.forwarding=1 --sysctl net.ipv4.conf.all.rp_filter=1 --sysctl net.ipv4.conf.default.rp_filter=1 --publish 127.0.0.1:9090:9090 --user 65532:65532 --cap-drop ALL --read-only --security-opt no-new-privileges --entrypoint /bin/sleep sparkbox-dev:latest infinity
docker run --rm --name sparkbox-dev-scrub-retired-gateway-state --label sparkbox.devpod=sparkbox-dev --label sparkbox.devpod.container=scrub-retired-gateway-state --platform linux/arm64 --network container:sparkbox-dev-netns --user 0 --cap-drop ALL --security-opt no-new-privileges --read-only --mount type=bind,src=/srv/sparkbox/data/devpod,dst=/var/lib/sparkbox --entrypoint /bin/sh sparkbox-dev:latest -ec 'rm -f \
  /var/lib/sparkbox/control/sparkbox.db \
  /var/lib/sparkbox/control/sparkbox.db-shm \
  /var/lib/sparkbox/control/sparkbox.db-wal \
  /var/lib/sparkbox/control/schedules.db \
  /var/lib/sparkbox/control/schedules.db-shm \
  /var/lib/sparkbox/control/schedules.db-wal \
  /var/lib/sparkbox/control/gateway_host_key.pem \
  /var/lib/sparkbox/control/gateway_upstream_key.pem \
  /var/lib/sparkbox/control/oidc_signing_key.pem \
  /var/lib/sparkbox/control/oidc_signing_key_prev.pem \
  /var/lib/sparkbox/control/node_ca_key.pem \
  /var/lib/sparkbox/control/gateway_control_key.pem
rm -rf \
  /var/lib/sparkbox/control/autocert \
  /var/lib/sparkbox/control/certmagic \
  /var/lib/sparkbox/control/favicons
'
docker run --rm --name sparkbox-dev-prepare-vm-assets --label sparkbox.devpod=sparkbox-dev --label sparkbox.devpod.container=prepare-vm-assets --platform linux/arm64 --network container:sparkbox-dev-netns --user 0 --cap-drop ALL --cap-add CHOWN --cap-add DAC_OVERRIDE --cap-add FOWNER --cap-add SYS_ADMIN --security-opt seccomp=unconfined --security-opt apparmor=unconfined --read-only --device /dev/loop-control:/dev/loop-control:rwm --device /dev/loop0:/dev/loop0:rwm --device /dev/loop1:/dev/loop1:rwm --device /dev/loop2:/dev/loop2:rwm --device /dev/loop3:/dev/loop3:rwm --device /dev/loop4:/dev/loop4:rwm --device /dev/loop5:/dev/loop5:rwm --device /dev/loop6:/dev/loop6:rwm --device /dev/loop7:/dev/loop7:rwm --mount type=volume,src=sparkbox-dev-tmp,dst=/tmp --mount type=volume,src=sparkbox-dev-checkpoint-scratch,dst=/mnt/sparkbox-durable --mount type=bind,src=/srv/sparkbox/devpod-trust,dst=/run/sparkbox/trust,readonly --mount type=bind,src=/srv/sparkbox/data/devpod,dst=/var/lib/sparkbox --env SPARKBOX_PROXY_DOMAIN=dev.catnip.sh --env SPARKBOX_RELEASE=v0.7.4 --env SPARKBOX_CHROOT_JAILER=true --env SPARKBOX_CONTROLLER_UID=65532 --env SPARKBOX_CONTROLLER_GID=65532 --env SPARKBOX_VM_STATE_DIR=/var/lib/sparkbox/hot/controller --env HIVEMIND_MANIFEST= --env GATEWAY_PUBLIC_KEY_FILE=/run/sparkbox/trust/gateway_upstream_key.pub sparkbox-dev:latest prepare
docker run --detach --name sparkbox-dev-vmm-helper --label sparkbox.devpod=sparkbox-dev --label sparkbox.devpod.container=vmm-helper --platform linux/arm64 --network container:sparkbox-dev-netns --user 0:0 --cap-drop ALL --cap-add CHOWN --cap-add DAC_OVERRIDE --cap-add DAC_READ_SEARCH --cap-add FOWNER --cap-add KILL --cap-add MKNOD --cap-add NET_ADMIN --cap-add SETGID --cap-add SETUID --cap-add SYS_CHROOT --security-opt no-new-privileges --read-only --device /dev/kvm:/dev/kvm:rwm --device /dev/net/tun:/dev/net/tun:rwm --mount type=volume,src=sparkbox-dev-sluice-socket,dst=/run/sluice,readonly --mount type=volume,src=sparkbox-dev-vmm-socket,dst=/run/sparkbox-vmm --mount type=bind,src=/srv/sparkbox/data/devpod,dst=/var/lib/sparkbox --env SPARKBOX_GUEST_SUBNET=172.30.0.0/20 --env SPARKBOX_RESTRICT_INTERNAL_EGRESS=1 --env SPARKBOX_SLUICE_DNS_IP=172.30.0.53 --env SPARKBOX_SLUICE_SOCKET=/run/sluice/sluice.sock --env SPARKBOX_PRIVILEGED_HELPER_SOCKET=/run/sparkbox-vmm/helper.sock --env SPARKBOX_CONTROLLER_UID=65532 --env SPARKBOX_CONTROLLER_GID=65532 --env SPARKBOX_VM_STATE_DIR=/var/lib/sparkbox/hot/controller --health-cmd '/bin/sh -ec '\''test -S /run/sparkbox-vmm/helper.sock'\''' --health-interval 2s --health-retries 10 --health-timeout 1s --entrypoint /usr/local/sbin/sparkbox-vmm-helper-entrypoint sparkbox-dev:latest
docker run --detach --name sparkbox-dev-sluice --label sparkbox.devpod=sparkbox-dev --label sparkbox.devpod.container=sluice --platform linux/arm64 --network container:sparkbox-dev-netns --user 0:0 --cap-drop ALL --cap-add BPF --cap-add NET_ADMIN --cap-add NET_BIND_SERVICE --security-opt no-new-privileges --read-only --mount type=volume,src=sparkbox-dev-sluice-socket,dst=/run/sluice --env SPARKBOX_GUEST_SUBNET=172.30.0.0/20 --env SPARKBOX_SLUICE_DNS_IP=172.30.0.53 --env SPARKBOX_SLUICE_SOCKET=/run/sluice/sluice.sock --health-cmd 'curl --fail --silent --show-error --unix-socket /run/sluice/sluice.sock http://sluice/report.json' --health-interval 5s --health-retries 3 --health-start-period 60s --health-timeout 1s --entrypoint /usr/local/sbin/sparkbox-sluice-entrypoint sparkbox-dev:latest
docker run --detach --name sparkbox-dev-sparkbox-node --label sparkbox.devpod=sparkbox-dev --label sparkbox.devpod.container=sparkbox-node --platform linux/arm64 --network container:sparkbox-dev-netns --user 65532:65532 --cap-drop ALL --security-opt no-new-privileges --read-only --mount type=volume,src=sparkbox-dev-tmp,dst=/tmp --mount type=volume,src=sparkbox-dev-checkpoint-scratch,dst=/mnt/sparkbox-durable --mount type=volume,src=sparkbox-dev-sluice-socket,dst=/run/sluice --mount type=volume,src=sparkbox-dev-vmm-socket,dst=/run/sparkbox-vmm --mount type=bind,src=/srv/sparkbox/devpod-trust,dst=/run/sparkbox/trust,readonly --mount type=bind,src=/srv/sparkbox/data/devpod,dst=/var/lib/sparkbox,readonly --mount type=bind,src=/srv/sparkbox/data/devpod/control,dst=/var/lib/sparkbox/control --mount type=bind,src=/srv/sparkbox/data/devpod/node-identity,dst=/var/lib/sparkbox/node-identity --mount type=bind,src=/srv/sparkbox/data/devpod/templates,dst=/var/lib/sparkbox/templates --mount type=bind,src=/srv/sparkbox/data/devpod/hot/controller,dst=/var/lib/sparkbox/hot/controller --env SPARKBOX_PROXY_DOMAIN=dev.catnip.sh --env SPARKBOX_HIVEMIND_API= --env SPARKBOX_RELEASE=v0.7.4 --env SPARKBOX_GUEST_SUBNET=172.30.0.0/20 --env SPARKBOX_HOST_MEM_MB=8192 --env SPARKBOX_MEM_ADMISSION_PCT=90 --env SPARKBOX_MAX_RUNNING_PER_OWNER=50 --env SPARKBOX_MAX_SANDBOXES_PER_OWNER=50 --env SPARKBOX_MEM_RESERVE_MB=256 --env SPARKBOX_OWNER_MEMORY_POOL_MB=12288 --env SPARKBOX_OWNER_MEMORY_BURST_MB=24576 --env SPARKBOX_DISK_POOL_MB_PER_OWNER=102400 --env SPARKBOX_GATEWAY_ADDR=192.168.64.1:2222 --env SPARKBOX_NODE_NAME=laptop-dev --env SPARKBOX_NODE_KEY_DIR=/var/lib/sparkbox/node-identity --env SPARKBOX_SKIP_PREPARE=true --env SPARKBOX_CHROOT_JAILER=true --env SPARKBOX_DISABLE_HOST_ROOTFS_MOUNTS=true --env SPARKBOX_PRIVILEGED_HELPER_SOCKET=/run/sparkbox-vmm/helper.sock --env SPARKBOX_CONTROLLER_UID=65532 --env SPARKBOX_CONTROLLER_GID=65532 --env SPARKBOX_VM_STATE_DIR=/var/lib/sparkbox/hot/controller --env SPARKBOX_SLUICE_SOCKET=/run/sluice/sluice.sock --env SPARKBOX_GUEST_DNS=172.30.0.53 sparkbox-dev:latest

# divergences
nodeSelector: dropped: compute.coreweave.com/node-pool=__SPARKBOX_NODE_POOL__, kubernetes.io/arch=amd64, kubernetes.io/hostname=__SPARKBOX_NODE__
  why: there is no scheduler. The CoreWeave node-pool and hostname labels name one physical machine, and kubernetes.io/arch is pinned to the cluster's amd64 while this plan renders arm64.
resources: requests and limits are not enforced (prepare-vm-assets cpu=250m memory=256Mi; vmm-helper cpu=48 memory=400Gi; sluice cpu=250m memory=256Mi; sparkbox-node cpu=1 memory=2Gi)
  why: docker has no scheduler to admit against and no node with 400Gi. The manifest values are left exactly as deployed so the plan keeps reporting what CKS reserves.
pod network: the docker bridge is pinned to 172.29.128.0/24
  why: a Pod does not own a bridge subnet, but a stock daemon's allocator takes one from 172.17.0.0/12 in /16 steps — a pool that contains the guest range 172.30.0.0/20, and a bridge that lands on top of the guest network breaks routing in a way that looks like anything but an address collision.
pod network: the Pod netns is a holder container (sparkbox-dev-netns) the others join with --network container:
  why: docker has no Pod. The shared namespace is load-bearing here: vmm-helper creates the TAPs and the 172.30.0.53 resolver address that sluice binds and sparkbox-node routes guests to.
pod network: sysctls net.ipv4.ip_forward, net.ipv6.conf.all.forwarding, net.ipv4.conf.all.rp_filter, net.ipv4.conf.default.rp_filter are set on the namespace holder
  why: vmm-helper-entrypoint.sh sets them best-effort with '|| true' because /proc/sys is read-only for an unprivileged container. Setting them at namespace creation is the only way they take effect locally.
service: service.yaml's LoadBalancer (22 ports) is not published
  why: its selector points at the gateway Pod, not this one. The ports are carried on Plan.Network.ServicePorts for whatever runs the gateway locally; if the Service is ever repointed at the node they publish automatically.
volume data: hostPath /mnt/local/sparkbox-poc (type DirectoryOrCreate) -> /srv/sparkbox/data/devpod, which `devpod down` keeps
  why: the CKS path is /mnt/local because that is the only storage there that supports reflinks. The local target must support them too — a VM clone is cp --reflink=always. It holds the VM inventory, the guest disks, the control SQLite, the node identity and the rootfs template, so teardown leaves it alone; `devpod down --purge-data` is the way to say otherwise. DirectoryOrCreate is reproduced by `devpod up` creating the bind sources itself.
volume gateway-trust: Secret sparkbox-node-trust (defaultMode 0444) -> /srv/sparkbox/devpod-trust
  why: there is no cluster Secret. defaultMode is not reproduced either; a bind keeps the host's modes.
volume tmp: emptyDir sizeLimit 1Gi -> unbounded docker volume sparkbox-dev-tmp
  why: docker volumes have no size limit. `devpod down` removes this one, which is what keeps it per-run the way an emptyDir is.
volume checkpoint-scratch: emptyDir sizeLimit 1Gi -> unbounded docker volume sparkbox-dev-checkpoint-scratch
  why: docker volumes have no size limit. `devpod down` removes this one, which is what keeps it per-run the way an emptyDir is.
volume vmm-socket: emptyDir sizeLimit 1Mi -> unbounded docker volume sparkbox-dev-vmm-socket
  why: docker volumes have no size limit. `devpod down` removes this one, which is what keeps it per-run the way an emptyDir is.
volume sluice-socket: emptyDir sizeLimit 1Mi -> unbounded docker volume sparkbox-dev-sluice-socket
  why: docker volumes have no size limit. `devpod down` removes this one, which is what keeps it per-run the way an emptyDir is.
securityContext: pod fsGroup 65532 / fsGroupChangePolicy OnRootMismatch not applied
  why: docker has no fsGroup. The prepare-vm-assets init container chowns the paths the controller actually writes, which is what makes this survivable.
serviceAccount: serviceAccountName sparkbox-node is ignored
  why: there is no API server. automountServiceAccountToken is false in the manifest, so nothing in the Pod reads one.
devices: sparkbox.dev/kvm, /tun and /loop are granted with --device from internal/deviceplugin.DefaultResources
  why: the device plugin needs a kubelet. The device table is imported rather than copied, so the plugin and this plan cannot disagree about what the loop bundle contains.
deployment: replicas 1, strategy Recreate is not enforced; devpod runs exactly one pod
  why: there is no Deployment controller. Recreate matters in CKS because the node owns exclusive devices and a SQLite file and must never overlap itself; locally the same guarantee comes from the fixed container names, which docker refuses to duplicate.
restartPolicy: crashed containers are not restarted
  why: the PodSpec omits restartPolicy, so Kubernetes restarts Always. Locally a crash should stay visible instead of looping, so no --restart is emitted.
imagePullPolicy: imagePullPolicy Always is ignored; the local image ref sparkbox-dev:latest is used as-is
  why: the image being tested is a local build, and pulling would replace it.
probes: tcpSocket probes are not reproduced (sparkbox-node liveness, sparkbox-node readiness, sparkbox-node startup)
  why: docker's HEALTHCHECK runs a command in the container, and the image has no TCP prober. Exec readiness probes are translated; these are not.
probes: exec livenessProbes are not reproduced (vmm-helper: /bin/sh -ec 'test -S /run/sparkbox-vmm/helper.sock')
  why: a container has exactly one docker HEALTHCHECK and this plan spends it on the readiness probe, which is the one `devpod status` reads. Nothing would act on a liveness failure anyway: no --restart is emitted (see restartPolicy), so a wedged helper stays visible instead of being killed and restarted the way CKS kills it.
arch: rendered linux/arm64; the cluster runs amd64
  why: the guest assets are built per architecture and are not bit-reproducible, so this pod fetches universal-arm64.ext4.zst and a different Firecracker binary than CKS does. entrypoint.sh resolves its own pin from uname, and --platform makes uname agree with this.
network policy: NetworkPolicy default-deny-ingress selects this Pod and is not enforced: deny all
  why: docker has no NetworkPolicy. In CKS nothing may open a connection to this Pod except what a later policy allows; locally the ports the Pod declares are published on the namespace holder, bound to 127.0.0.1 so at least they do not leave the machine.
network policy: CiliumNetworkPolicy vm-node-public-egress selects this Pod and is not enforced: sparkbox-gateway.sparkbox-poc:2222/tcp; coredns.kube-system:53/udp,53/tcp; 0.0.0.0/0 except 0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 127.0.0.0/8 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 192.0.2.0/24 192.88.99.0/24 192.168.0.0/16 198.18.0.0/15 198.51.100.0/24 203.0.113.0/24 224.0.0.0/4 240.0.0.0/4; ::/0 except ::/128 ::1/128 ::ffff:0:0/96 64:ff9b:1::/48 100::/64 2001:db8::/32 fc00::/7 fe80::/10 ff00::/8
  why: docker has no NetworkPolicy and no Cilium. This one confines the node's egress — and, after the helper's IPv4 masquerade, its guests' egress — to the public internet; locally nothing stops either from reaching the whole host LAN. sluice still enforces its DNS allow-list inside the pod, so what is missing is the IP-level backstop underneath it.
init containers: init containers run as separate `docker run --rm` invocations, in order
  why: docker has no init-container concept. Each must exit 0 before the next command runs, which is the ordering guarantee prepare-vm-assets depends on.
