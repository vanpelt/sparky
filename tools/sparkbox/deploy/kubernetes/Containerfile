FROM --platform=$BUILDPLATFORM golang:1.25-bookworm AS build

ARG TARGETARCH
ARG TARGETOS
ARG SPARKBOX_VERSION=dev-cks

WORKDIR /src/sparkbox
COPY sparkbox/go.mod sparkbox/go.sum ./
RUN go mod download

COPY sparkbox/ .
RUN CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" \
    go build -trimpath \
      -ldflags="-s -w -X main.version=${SPARKBOX_VERSION}" \
      -o /out/sparkbox ./cmd/sparkbox \
    && CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" \
      go build -trimpath \
      -ldflags="-s -w" \
	  -o /out/sparkbox-device-plugin ./cmd/sparkbox-device-plugin \
	&& CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" \
	  go build -trimpath \
	  -ldflags="-s -w" \
	  -o /out/sparkbox-vmm-helper ./cmd/sparkbox-vmm-helper

WORKDIR /src/sluice
COPY sluice/go.mod sluice/go.sum ./
RUN go mod download
COPY sluice/ .
RUN CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" \
    go build -trimpath -ldflags="-s -w" -o /out/sluice ./cmd/sluice

FROM ubuntu:24.04

# TARGETARCH is what makes this ONE image that can run either VMM. Firecracker,
# the guest kernel and the rootfs are still downloaded and SHA-256-verified at
# Pod start by entrypoint.sh, because they are release artifacts we publish and
# pin. QEMU is not: it is a distro package with a large dynamic closure and no
# upstream static build, so it is baked in here instead.
#
# The per-arch package name matters. `qemu-system` is a metapackage that pulls
# in every target emulator -- hundreds of megabytes of machines we will never
# boot -- so pick the one that matches and fail loudly on an architecture nobody
# has thought about, rather than silently shipping an image with no VMM in it.
# hack/parity/Dockerfile has done exactly this since the parity suite existed;
# this is the same rule in the image we actually deploy.
#
# Ubuntu 24.04 ships QEMU 8.2.2, which is the floor the driver requires: the
# `file:` migration URI that Pause depends on landed in 8.2, and pc-q35-8.2 /
# virt-8.2 are the versioned machine types the driver pins snapshots to.
ARG TARGETARCH
RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) qemu_pkg=qemu-system-x86 ;; \
      arm64) qemu_pkg=qemu-system-arm ;; \
      *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates \
      coreutils \
      curl \
      e2fsprogs \
      iproute2 \
      iptables \
      openssh-client \
      procps \
      python3 \
      util-linux \
      zerofree \
      zstd \
      "$qemu_pkg"; \
    rm -rf /var/lib/apt/lists/*

# Prove the arch-specific half above did what it claims, at BUILD time rather
# than on a node an hour later, and prove the version floor while we are here.
RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) qemu=qemu-system-x86_64 ;; \
      arm64) qemu=qemu-system-aarch64 ;; \
    esac; \
    "$qemu" --version | head -1; \
    "$qemu" --version | head -1 | grep -qE 'version (8\.[2-9]|[9-9][0-9]*\.|[1-9][0-9]+\.)' \
      || { echo "QEMU is older than the 8.2 the driver requires" >&2; exit 1; }

COPY --from=build /out/sparkbox /usr/local/bin/sparkbox
COPY --from=build /out/sparkbox-device-plugin /usr/local/bin/sparkbox-device-plugin
COPY --from=build /out/sparkbox-vmm-helper /usr/local/bin/sparkbox-vmm-helper
COPY --from=build /out/sluice /usr/local/bin/sluice
COPY sparkbox/deploy/sparkbox-net.sh /usr/local/sbin/sparkbox-net.sh
COPY sparkbox/deploy/refresh-agent-tools.sh /usr/local/sbin/sparkbox-refresh-tools.sh
COPY sparkbox/deploy/install-guest-identity.sh /usr/local/sbin/sparkbox-install-guest-identity.sh
COPY sparkbox/images/motd /usr/local/share/sparkbox/motd
COPY sparkbox/deploy/sluice-allowlist.txt /etc/sparkbox/sluice-allowlist.txt
COPY sparkbox/deploy/kubernetes/entrypoint.sh /usr/local/sbin/sparkbox-kubernetes-entrypoint
COPY sparkbox/deploy/kubernetes/gateway-entrypoint.sh /usr/local/sbin/sparkbox-gateway-entrypoint
COPY sparkbox/deploy/kubernetes/sluice-entrypoint.sh /usr/local/sbin/sparkbox-sluice-entrypoint
COPY sparkbox/deploy/kubernetes/vmm-helper-entrypoint.sh /usr/local/sbin/sparkbox-vmm-helper-entrypoint

RUN chmod 0755 \
      /usr/local/bin/sparkbox \
      /usr/local/bin/sparkbox-device-plugin \
	  /usr/local/bin/sparkbox-vmm-helper \
	  /usr/local/bin/sluice \
      /usr/local/sbin/sparkbox-install-guest-identity.sh \
      /usr/local/sbin/sparkbox-net.sh \
      /usr/local/sbin/sparkbox-refresh-tools.sh \
      /usr/local/sbin/sparkbox-kubernetes-entrypoint \
	  /usr/local/sbin/sparkbox-gateway-entrypoint \
	  /usr/local/sbin/sparkbox-sluice-entrypoint \
	  /usr/local/sbin/sparkbox-vmm-helper-entrypoint

STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/sbin/sparkbox-kubernetes-entrypoint"]
