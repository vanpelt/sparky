[Unit]
Description=sparkbox host packet-filter rules (sandbox NAT + metadata port)
# After network: the script derives the uplink from the default route.
# Before sparkbox: no sandbox should exist before its egress path does.
After=network-online.target
Wants=network-online.target
Before=sparkbox.service

[Service]
Type=oneshot
RemainAfterExit=yes
# SUBNET6 (enables the v6 REDIRECT branch) + PROXY_PORT (edge listener) live in
# sparkbox.env; without this the script sees neither and only v4 forwards.
EnvironmentFile=/srv/sparkbox/sparkbox.env
ExecStart=/usr/local/sbin/sparkbox-net.sh

[Install]
WantedBy=multi-user.target
