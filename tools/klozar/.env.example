# Clozemaster session cookie. Grab it once from Chrome:
#   DevTools > Application > Cookies > https://www.clozemaster.com > _clozemaster_session
# It is HttpOnly, so page JavaScript cannot read it — you have to copy it by hand.
# When it expires klozar says so instead of silently emitting an empty sheet.
CLOZEMASTER_SESSION=paste_the_value_here

# Language pairing slug. srp-eng = Serbian from English.
CLOZEMASTER_PAIRING=srp-eng
