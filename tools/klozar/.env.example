# The session cookie is NOT kept here — run `uv run klozar.py auth` and it goes
# into the macOS login Keychain, where klozar re-saves the rotated value after
# every run. That rotation is what keeps it alive, so a copy pinned in a file
# just goes stale.

# Language pairing slug. srp-eng = Serbian from English.
CLOZEMASTER_PAIRING=srp-eng
